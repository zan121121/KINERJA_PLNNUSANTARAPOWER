<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Tambah Data Assesmen - e-Kinerja HC</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar', { pageTitle: 'Tambah Data Assesmen' }) %>

  <main class="ml-64 pt-16 p-6">
    <a href="/hcr-assesmen" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-brand-blue mb-4">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali
    </a>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-w-xl">
      <p class="text-base font-bold text-gray-800 mb-1">Tambah Data Assesmen</p>
      <p class="text-sm text-gray-400 mb-5">Lengkapi form untuk menambahkan data assesmen kompetensi pegawai</p>

      <% if (errorMsg && errorMsg.length > 0) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg mb-4"><%= errorMsg %></div>
      <% } %>

      <form action="/hcr-assesmen/tambah" method="POST" class="space-y-4">
        <input type="hidden" name="bulan" value="<%= bulan %>">
        <input type="hidden" name="tahun" value="<%= tahun %>">

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Pegawai</label>
          <select name="pegawai_id" required class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
            <% pegawai.forEach(p => { %>
              <option value="<%= p.id %>"><%= p.nama %> (<%= p.nip %>)</option>
            <% }) %>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Jenis Assesmen</label>
          <input type="text" name="jenis_assesmen" required placeholder="Contoh: Assesmen Kompetensi Teknis"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Tanggal Assesmen</label>
          <input type="date" name="tanggal_assesmen"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Status</label>
          <select name="status" required class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
            <option value="Belum">Belum</option>
            <option value="Selesai">Selesai</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Skor (opsional)</label>
          <input type="number" step="0.01" name="skor"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Catatan</label>
          <textarea name="catatan" rows="2" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue"></textarea>
        </div>

        <div class="flex gap-3 pt-2">
          <a href="/hcr-assesmen" class="flex-1 text-center border border-gray-200 text-gray-600 py-2.5 rounded-lg font-semibold text-sm hover:bg-gray-50">Batal</a>
          <button type="submit" class="flex-1 bg-brand-blue text-white font-semibold py-2.5 rounded-lg text-sm shadow-sm hover:opacity-90">Simpan</button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
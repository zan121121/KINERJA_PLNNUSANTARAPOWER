<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Edit Jadwal PPK - e-Kinerja HC</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar', { pageTitle: 'Edit Jadwal PPK' }) %>

  <main class="ml-64 pt-16 p-6">
    <a href="/hcr-pelaksanaan" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-brand-blue mb-4">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali
    </a>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-w-xl">
      <p class="text-base font-bold text-gray-800 mb-1">Edit Jadwal & Monitoring PPK</p>
      <p class="text-sm text-gray-400 mb-5"><%= data.nama %> · <%= data.nip %></p>

      <form action="/hcr-pelaksanaan/edit/<%= data.id %>" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Nama Kegiatan</label>
          <input type="text" name="nama_kegiatan" required value="<%= data.nama_kegiatan %>"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Jadwal Tanggal</label>
          <input type="date" name="jadwal_tanggal" value="<%= data.jadwal_tanggal ? data.jadwal_tanggal.toISOString().split('T')[0] : '' %>"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Status</label>
          <select name="status" required class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
            <option value="Terjadwal" <%= data.status === 'Terjadwal' ? 'selected' : '' %>>Terjadwal</option>
            <option value="Berlangsung" <%= data.status === 'Berlangsung' ? 'selected' : '' %>>Berlangsung</option>
            <option value="Selesai" <%= data.status === 'Selesai' ? 'selected' : '' %>>Selesai</option>
            <option value="Terlambat" <%= data.status === 'Terlambat' ? 'selected' : '' %>>Terlambat</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Log Aktivitas</label>
          <textarea name="log_aktivitas" rows="3" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue"><%= data.log_aktivitas || '' %></textarea>
        </div>

        <div class="flex gap-3 pt-2">
          <a href="/hcr-pelaksanaan" class="flex-1 text-center border border-gray-200 text-gray-600 py-2.5 rounded-lg font-semibold text-sm hover:bg-gray-50">Batal</a>
          <button type="submit" class="flex-1 bg-brand-blue text-white font-semibold py-2.5 rounded-lg text-sm shadow-sm hover:opacity-90">Simpan Perubahan</button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
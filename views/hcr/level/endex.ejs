<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Atur Level HCR - e-Kinerja HC</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar', { pageTitle: 'Atur Level HCR' }) %>

  <main class="ml-64 pt-16 p-6">
    <a href="/hcr-menu" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-brand-blue mb-4">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali ke Menu HCR
    </a>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-w-2xl">
      <p class="text-base font-bold text-gray-800 mb-1">Atur Level HCR</p>
      <p class="text-sm text-gray-400 mb-5">Tentukan rentang skor gabungan untuk tiap level pencapaian pegawai</p>

      <% if (successMsg && successMsg.length > 0) { %>
        <div class="bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3 rounded-lg mb-4"><%= successMsg %></div>
      <% } %>

      <form action="/hcr-level" method="POST" class="space-y-3">
        <div class="grid grid-cols-12 gap-2 text-xs font-semibold text-gray-400 px-1">
          <div class="col-span-5">Nama Level</div>
          <div class="col-span-3">Skor Min (%)</div>
          <div class="col-span-3">Skor Maks (%)</div>
        </div>
        <% levels.forEach(l => { %>
          <div class="grid grid-cols-12 gap-2 items-center">
            <input type="text" name="level_label[<%= l.id %>]" value="<%= l.level_label %>"
              class="col-span-5 border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
            <input type="number" step="0.1" name="min_skor[<%= l.id %>]" value="<%= l.min_skor %>"
              class="col-span-3 border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
            <input type="number" step="0.1" name="max_skor[<%= l.id %>]" value="<%= l.max_skor %>"
              class="col-span-3 border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
          </div>
        <% }) %>

        <button type="submit" class="w-full bg-brand-blue text-white font-semibold py-2.5 rounded-lg text-sm shadow-sm hover:opacity-90 mt-4">
          Simpan Konfigurasi Level
        </button>
      </form>
    </div>
  </main>
</body>
</html>
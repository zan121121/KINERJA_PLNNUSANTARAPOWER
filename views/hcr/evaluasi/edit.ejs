<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Edit Evaluasi PPK - e-Kinerja HC</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar', { pageTitle: 'Edit Evaluasi PPK' }) %>

  <main class="ml-64 pt-16 p-6">
    <a href="/hcr-evaluasi" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-brand-blue mb-4">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali
    </a>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-w-xl">
      <p class="text-base font-bold text-gray-800 mb-1">Edit Evaluasi PPK</p>
      <p class="text-sm text-gray-400 mb-5"><%= data.nama %> · <%= data.nip %></p>

      <form action="/hcr-evaluasi/edit/<%= data.id %>" method="POST" enctype="multipart/form-data" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Nama Program</label>
          <input type="text" name="nama_program" required value="<%= data.nama_program %>"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Tanggal Evaluasi</label>
          <input type="date" name="tanggal_evaluasi" value="<%= data.tanggal_evaluasi ? data.tanggal_evaluasi.toISOString().split('T')[0] : '' %>"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Skor Evaluasi (0-100)</label>
          <input type="number" step="0.01" min="0" max="100" name="skor_evaluasi" required value="<%= data.skor_evaluasi %>"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Bukti Dukung Saat Ini</label>
          <% if (data.file_bukti) { %>
            <a href="/uploads/evaluasi-ppk/<%= data.file_bukti %>" target="_blank" class="text-blue-600 hover:underline text-sm block mb-2">📎 Lihat file saat ini</a>
          <% } else { %>
            <p class="text-gray-400 text-sm mb-2">Belum ada file</p>
          <% } %>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Ganti File (kosongkan jika tidak ingin ganti)</label>
          <input type="file" name="file_bukti" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Catatan</label>
          <textarea name="catatan" rows="2" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue"><%= data.catatan || '' %></textarea>
        </div>

        <div class="flex gap-3 pt-2">
          <a href="/hcr-evaluasi" class="flex-1 text-center border border-gray-200 text-gray-600 py-2.5 rounded-lg font-semibold text-sm hover:bg-gray-50">Batal</a>
          <button type="submit" class="flex-1 bg-brand-blue text-white font-semibold py-2.5 rounded-lg text-sm shadow-sm hover:opacity-90">Simpan Perubahan</button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Edit Penugasan - e-Kinerja HC</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar', { pageTitle: 'Edit Penugasan' }) %>

  <main class="ml-64 pt-16 p-6">
    <a href="/hcr-penugasan" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-brand-blue mb-4">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali
    </a>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-w-xl">
      <p class="text-base font-bold text-gray-800 mb-1">Edit Penugasan</p>
      <p class="text-sm text-gray-400 mb-5"><%= data.nama %> · <%= data.nip %></p>

      <form action="/hcr-penugasan/edit/<%= data.id %>" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Nama Penugasan</label>
          <input type="text" name="nama_penugasan" required value="<%= data.nama_penugasan %>"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium text-gray-600 mb-1.5">Target</label>
            <input type="number" step="0.01" name="target" value="<%= data.target %>" required
              class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-600 mb-1.5">Realisasi</label>
            <input type="number" step="0.01" name="realisasi" value="<%= data.realisasi %>" required
              class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Catatan</label>
          <textarea name="catatan" rows="2" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue"><%= data.catatan || '' %></textarea>
        </div>

        <div class="flex gap-3 pt-2">
          <a href="/hcr-penugasan" class="flex-1 text-center border border-gray-200 text-gray-600 py-2.5 rounded-lg font-semibold text-sm hover:bg-gray-50">Batal</a>
          <button type="submit" class="flex-1 bg-brand-blue text-white font-semibold py-2.5 rounded-lg text-sm shadow-sm hover:opacity-90">Simpan Perubahan</button>
        </div>
      </form>
    </div>
  </main>
</body>
</html>
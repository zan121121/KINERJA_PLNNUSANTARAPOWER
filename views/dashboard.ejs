<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Dashboard - PLN Nusantara Power</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('partials/sidebar') %>
  <%- include('partials/topbar', { pageTitle: 'Dashboard' }) %>

  <main class="ml-64 pt-16 p-6">
    <div id="stat-cards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <p class="text-gray-400 text-sm col-span-full">Memuat ringkasan...</p>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 mb-6">
      <p class="text-base font-bold text-gray-800 mb-1">Distribusi Skor HCR Pegawai</p>
      <p class="text-sm text-gray-400 mb-5">Berdasarkan skor gabungan berbobot, periode bulan ini</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="border border-gray-100 rounded-lg p-4 flex flex-col items-center">
          <div class="relative w-28 h-28">
            <canvas id="chartRendah"></canvas>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <p id="persen-rendah" class="text-lg font-bold text-red-600">0%</p>
            </div>
          </div>
          <p class="text-sm font-semibold text-gray-700 mt-3">Perlu Perhatian</p>
          <p class="text-xs text-gray-400">Skor &lt; 60% · <span id="jumlah-rendah">0</span> pegawai</p>
        </div>

        <div class="border border-gray-100 rounded-lg p-4 flex flex-col items-center">
          <div class="relative w-28 h-28">
            <canvas id="chartSedang"></canvas>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <p id="persen-sedang" class="text-lg font-bold text-amber-600">0%</p>
            </div>
          </div>
          <p class="text-sm font-semibold text-gray-700 mt-3">Berkembang</p>
          <p class="text-xs text-gray-400">Skor 60–85% · <span id="jumlah-sedang">0</span> pegawai</p>
        </div>

        <div class="border border-gray-100 rounded-lg p-4 flex flex-col items-center">
          <div class="relative w-28 h-28">
            <canvas id="chartTinggi"></canvas>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <p id="persen-tinggi" class="text-lg font-bold text-green-600">0%</p>
            </div>
          </div>
          <p class="text-sm font-semibold text-gray-700 mt-3">Unggul</p>
          <p class="text-xs text-gray-400">Skor &gt; 85% · <span id="jumlah-tinggi">0</span> pegawai</p>
        </div>
      </div>
    </div>

  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
  <script>
    async function muatDistribusi() {
      try {
        const res = await fetch('/hcr-skor-gabungan-json');
        const { data } = await res.json();

        const total = data.length || 1;
        const rendah = data.filter(d => d.kategori === 'Rendah').length;
        const sedang = data.filter(d => d.kategori === 'Sedang').length;
        const tinggi = data.filter(d => d.kategori === 'Tinggi').length;

        const persenRendah = ((rendah / total) * 100).toFixed(0);
        const persenSedang = ((sedang / total) * 100).toFixed(0);
        const persenTinggi = ((tinggi / total) * 100).toFixed(0);

        document.getElementById('jumlah-rendah').textContent = rendah;
        document.getElementById('jumlah-sedang').textContent = sedang;
        document.getElementById('jumlah-tinggi').textContent = tinggi;

        document.getElementById('persen-rendah').textContent = persenRendah + '%';
        document.getElementById('persen-sedang').textContent = persenSedang + '%';
        document.getElementById('persen-tinggi').textContent = persenTinggi + '%';

        buatDonat('chartRendah', persenRendah, '#dc2626');
        buatDonat('chartSedang', persenSedang, '#d97706');
        buatDonat('chartTinggi', persenTinggi, '#16a34a');
      } catch (err) {
        console.error('Gagal memuat distribusi:', err);
      }
    }

    function buatDonat(canvasId, persen, warna) {
      const ctx = document.getElementById(canvasId).getContext('2d');
      new Chart(ctx, {
        type: 'doughnut',
        data: {
          datasets: [{
            data: [persen, 100 - persen],
            backgroundColor: [warna, '#f3f4f6'],
            borderWidth: 0
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: true,
          cutout: '75%',
          plugins: { legend: { display: false }, tooltip: { enabled: false } },
          animation: { animateRotate: true }
        }
      });
    }

    muatDistribusi();

    async function muatStatCards() {
      const wrapper = document.getElementById('stat-cards');
      try {
        const resPegawai = await fetch('/pegawai');
        const html = await resPegawai.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const jumlahPegawai = doc.querySelectorAll('tbody tr[data-nama], tbody tr').length;

        wrapper.innerHTML = `
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
            <div class="w-11 h-11 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 100-8 4 4 0 000 8zm6 1a4 4 0 10-8 0" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400">Total Pegawai</p>
              <p class="text-xl font-bold text-gray-800">${jumlahPegawai}</p>
            </div>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
            <div class="w-11 h-11 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400">Modul HCR Aktif</p>
              <p class="text-xl font-bold text-gray-800">8 / 8</p>
            </div>
          </div>
          <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
            <div class="w-11 h-11 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2M5 21h2m4-15h2M9 10h2M9 14h2M9 18h2m2-15h2m-2 4h2m-2 4h2m-2 4h2" />
              </svg>
            </div>
            <div>
              <p class="text-xs text-gray-400">Unit</p>
              <p class="text-xl font-bold text-gray-800">UPBW Belawan</p>
            </div>
          </div>
        `;
      } catch (err) {
        wrapper.innerHTML = '<p class="text-gray-400 text-sm col-span-full">Gagal memuat ringkasan</p>';
      }
    }
    muatStatCards();
  </script>
</body>
</html>
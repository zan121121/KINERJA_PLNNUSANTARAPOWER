<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
<title>Dashboard - PLN Nusantara Power</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('partials/sidebar') %>
  <%- include('partials/topbar', { pageTitle: 'Dashboard' }) %>

  <main class="ml-64 pt-16 p-6">
    <div id="stat-cards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
      <p class="text-gray-400 text-sm col-span-full">Memuat ringkasan...</p>
    </div>
  </main>

  <script>
    async function muatRingkasan() {
      try {
        const [resPegawai, resItems] = await Promise.all([
          fetch('/pegawai/detail/0/json').catch(() => null), // placeholder aman kalau endpoint beda
        ]);
      } catch (e) {}
    }

    // Ambil jumlah pegawai & status modul HCR secara sederhana lewat endpoint yang sudah ada
    async function muatStatCards() {
      const wrapper = document.getElementById('stat-cards');
      try {
        const resPegawai = await fetch('/pegawai');
        // Karena /pegawai me-render HTML (bukan JSON), kita hitung dari DOM sederhana via fetch teks
        const html = await resPegawai.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const jumlahPegawai = doc.querySelectorAll('tbody tr[data-nama], tbody tr').length;

      wrapper.innerHTML = `
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
    <div class="w-11 h-11 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 100-8 4 4 0 000 8zm6 1a4 4 0 10-8 0" />
      </svg>
    </div>
    <div>
      <p class="text-xs text-gray-400">Total Pegawai</p>
      <p class="text-xl font-bold text-gray-800">${jumlahPegawai}</p>
    </div>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
    <div class="w-11 h-11 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
    </div>
    <div>
      <p class="text-xs text-gray-400">Modul HCR Aktif</p>
      <p class="text-xl font-bold text-gray-800">8 / 8</p>
    </div>
  </div>
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 flex items-center gap-4">
    <div class="w-11 h-11 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2M5 21h2m4-15h2M9 10h2M9 14h2M9 18h2m2-15h2m-2 4h2m-2 4h2m-2 4h2" />
      </svg>
    </div>
    <div>
      <p class="text-xs text-gray-400">Unit</p>
      <p class="text-xl font-bold text-gray-800">UPBW Belawan</p>
    </div>
  </div>
`;
      } catch (err) {
        wrapper.innerHTML = '<p class="text-gray-400 text-sm col-span-full">Gagal memuat ringkasan</p>';
      }
    }
    muatStatCards();
  </script>
</body>
</html>
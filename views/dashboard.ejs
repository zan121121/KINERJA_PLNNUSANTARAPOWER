<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Dashboard - PLN Nusantara Power</title>
<link rel="stylesheet" href="/css/output.css">

<style>
body{font-family:Inter,Arial,sans-serif}
.card{background:#fff;border:1px solid #e8edf3;border-radius:18px;
box-shadow:0 4px 18px rgba(15,23,42,.04)}
.stat{transition:.2s}.stat:hover{transform:translateY(-3px);
box-shadow:0 10px 25px rgba(15,23,42,.08)}
.progress{height:6px;background:#edf1f5;border-radius:10px;overflow:hidden}
.bar{height:100%;border-radius:10px}
.ocr{background:linear-gradient(135deg,#fafdff,#eefaff)}
.ocr-box{border:2px dashed #cbdde5;transition:.2s}
.ocr-box:hover{border-color:#06b6d4;background:#f9fdff}
.drawer{transition:.3s ease}
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:10px}
@media(max-width:768px){
main{margin-left:0!important;padding:80px 14px 20px}
}
</style>
</head>

<body class="bg-[#f6f8fb] text-slate-800">

<%- include('partials/sidebar') %>
<%- include('partials/topbar',{pageTitle:'Dashboard'}) %>

<main class="ml-64 pt-16 p-5 lg:p-6">

<!-- HERO -->
<div class="rounded-2xl p-6 mb-5 text-white relative overflow-hidden"
style="background:linear-gradient(135deg,#092653,#0b426c)">

<div class="relative z-10">
<div class="flex items-center gap-2 mb-2">
<span class="w-2 h-2 bg-emerald-400 rounded-full"></span>
<span class="text-emerald-300 text-[10px] font-bold uppercase tracking-widest">
System Online
</span>
</div>

<h1 class="text-2xl font-bold">Monitoring Dashboard</h1>

<p class="text-white/60 text-sm mt-1">
Monitoring HCR & OCR • UPBW Belawan
</p>
</div>

<div class="absolute -right-12 -top-20 w-56 h-56 rounded-full
bg-cyan-400/10"></div>

<div class="absolute right-12 bottom-5 w-20 h-20
rounded-full border border-white/10"></div>
</div>


<!-- STAT -->
<div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-5">

<% [
['Total Pegawai','blue','P'],
['Modul HCR','amber','✓'],
['Rata-rata Skor','green','%'],
['Pegawai Unggul','indigo','★']
].forEach(x=>{ %>

<div class="card stat p-5">
<div class="flex justify-between items-center">

<div>
<p class="text-xs text-slate-400"><%=x[0]%></p>

<h2 class="text-2xl font-bold mt-1 stat-value">-</h2>

<p class="text-[10px] text-slate-400 mt-2">
Data monitoring terbaru
</p>
</div>

<div class="w-11 h-11 rounded-xl bg-<%=x[1]%>-50
text-<%=x[1]%>-600 flex items-center justify-center font-bold">
<%=x[2]%>
</div>

</div>
</div>

<% }) %>
</div>


<!-- HCR + OCR -->
<div class="grid xl:grid-cols-3 gap-5 mb-5">

<!-- HCR STATUS -->
<div class="card xl:col-span-2 p-5">

<div class="flex justify-between items-center mb-5">

<div>
<p class="text-[10px] text-cyan-600 font-bold uppercase tracking-widest">
Human Capital Rating
</p>

<h2 class="font-bold text-lg mt-1">
Monitoring HCR
</h2>

<p class="text-xs text-slate-400">
Evaluasi dan pemantauan performa pegawai
</p>
</div>

<div class="flex items-center gap-2 text-[10px]">
<span class="w-2 h-2 bg-emerald-500 rounded-full"></span>
<span class="text-emerald-600 font-semibold">Aktif</span>
</div>

</div>

<div class="grid sm:grid-cols-3 gap-3">

<div class="bg-slate-50 rounded-xl p-4">
<p class="text-[10px] text-slate-400">Data Pegawai</p>
<p class="font-bold text-lg mt-1">Terpantau</p>
<p class="text-[10px] text-emerald-500 mt-1">Realtime</p>
</div>

<div class="bg-slate-50 rounded-xl p-4">
<p class="text-[10px] text-slate-400">Penilaian</p>
<p class="font-bold text-lg mt-1">8 Modul</p>
<p class="text-[10px] text-cyan-500 mt-1">Tersedia</p>
</div>

<div class="bg-slate-50 rounded-xl p-4">
<p class="text-[10px] text-slate-400">Status Sistem</p>
<p class="font-bold text-lg mt-1">Online</p>
<p class="text-[10px] text-emerald-500 mt-1">Normal</p>
</div>

</div>
</div>


<!-- OCR -->
<div class="card ocr p-5">

<div class="flex justify-between items-start mb-4">

<div>
<p class="text-[10px] text-cyan-600 font-bold uppercase">
Document Intelligence
</p>

<h2 class="font-bold text-lg mt-1">OCR</h2>

<p class="text-xs text-slate-400 mt-1">
Otomatisasi pembacaan dokumen
</p>
</div>

<span class="px-2 py-1 rounded-full bg-emerald-50
text-emerald-600 text-[9px] font-bold">
READY
</span>

</div>

<div class="ocr-box rounded-xl bg-white/70 p-5 text-center">

<div class="w-11 h-11 mx-auto rounded-xl bg-cyan-50
text-cyan-500 flex items-center justify-center mb-3">

<svg width="22" height="22" fill="none"
stroke="currentColor" stroke-width="1.8">
<path d="M12 16V4m0 0L7 9m5-5 5 5"/>
<path d="M5 20h14"/>
</svg>

</div>

<p class="text-xs font-semibold">
Pemrosesan Dokumen
</p>

<p class="text-[10px] text-slate-400 mt-1">
PDF / JPG / PNG
</p>

<button disabled
class="mt-3 px-4 py-2 rounded-lg bg-slate-100
text-slate-400 text-[10px] font-semibold">
Segera Hadir
</button>

</div>

<div class="flex justify-between mt-4 text-[10px]">
<span class="text-slate-400">OCR Engine</span>
<span class="text-amber-500 font-semibold">Development</span>
</div>

</div>
</div>


<!-- LEVEL -->
<div class="grid xl:grid-cols-3 gap-5 mb-5">

<div class="card xl:col-span-2 p-5">

<div class="flex flex-col sm:flex-row sm:justify-between
sm:items-center gap-3 mb-3">

<div>
<h2 class="font-bold">Distribusi Pegawai</h2>

<p class="text-xs text-slate-400">
Komposisi berdasarkan level
</p>
</div>

<div class="flex gap-2">

<select id="filter-bulan"
class="border border-slate-200 rounded-lg px-2 py-2
text-xs bg-white">

<% ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu',
'Sep','Okt','Nov','Des'].forEach((m,i)=>{ %>

<option value="<%=i+1%>"><%=m%></option>

<% }) %>

</select>

<input id="filter-tahun" type="number"
value="<%=new Date().getFullYear()%>"
class="border border-slate-200 rounded-lg px-2 py-2
text-xs w-20">

</div>
</div>


<div class="relative h-[330px]">

<canvas id="chartLevel"></canvas>

<div class="absolute inset-0 flex items-center
justify-center pointer-events-none">

<div class="text-center">

<b id="totalChart"
class="text-4xl font-bold">0</b>

<p class="text-[10px] text-slate-400 uppercase">
Pegawai
</p>

</div>
</div>

</div>
</div>


<!-- SUMMARY -->
<div class="card p-5">

<div class="flex justify-between items-center mb-1">

<h2 class="font-bold">Level Pegawai</h2>

<span class="text-[9px] bg-cyan-50 text-cyan-600
px-2 py-1 rounded-full">
DETAIL
</span>

</div>

<p class="text-xs text-slate-400 mb-4">
Klik level untuk membuka detail
</p>

<div id="ringkasan-level" class="space-y-2">
<p class="text-xs text-slate-400">
Memuat data...
</p>
</div>

</div>
</div>


<!-- TREND -->
<div class="card p-5">

<div class="flex flex-col sm:flex-row sm:justify-between
sm:items-center gap-3 mb-4">

<div>
<p class="text-[10px] text-cyan-600 font-bold uppercase">
Performance Analytics
</p>

<h2 class="font-bold">Tren Skor HCR</h2>

<p class="text-xs text-slate-400">
Rata-rata skor tahunan
</p>
</div>

<div class="flex gap-1 bg-slate-50 p-1 rounded-lg">

<% const th=new Date().getFullYear(); %>

<% [th-2,th-1,th].forEach(t=>{ %>

<button data-tahun="<%=t%>"
class="tahun-btn px-3 py-1.5 rounded-md text-xs
<%=t===th?'bg-white shadow text-slate-800':'text-slate-400'%>">
<%=t%>
</button>

<% }) %>

</div>

</div>

<div class="h-[280px]">
<canvas id="chartTren"></canvas>
</div>

</div>

</main>


<!-- DRAWER -->
<div id="drawer-bg"
class="hidden fixed inset-0 bg-slate-900/30 z-40"></div>

<aside id="drawer"
class="fixed top-0 right-0 h-full w-[390px] max-w-[92vw]
bg-white z-50 shadow-2xl translate-x-full drawer">

<div class="h-full flex flex-col">

<!-- DRAWER HEADER -->
<div class="p-5 border-b border-slate-100">

<div class="flex justify-between items-start">

<div>

<p class="text-[10px] text-cyan-600 font-bold uppercase tracking-widest">
Level Pegawai
</p>

<h2 id="detail-title"
class="text-xl font-bold mt-1">
Detail
</h2>

</div>

<button id="close-detail"
class="w-9 h-9 rounded-xl hover:bg-slate-100
text-slate-400 text-xl">
×
</button>

</div>


<div class="grid grid-cols-2 gap-3 mt-5">

<div class="bg-slate-50 rounded-xl p-3">

<p class="text-[10px] text-slate-400">
Total Pegawai
</p>

<b id="detail-total"
class="text-lg">0</b>

</div>

<div class="bg-slate-50 rounded-xl p-3">

<p class="text-[10px] text-slate-400">
Rata-rata Skor
</p>

<b id="detail-score"
class="text-lg">0%</b>

</div>

</div>


<!-- SEARCH -->
<div class="relative mt-4">

<input id="searchPegawai"
type="text"
placeholder="Cari nama pegawai..."
class="w-full border border-slate-200 rounded-xl
px-4 py-2.5 text-xs outline-none
focus:border-cyan-400">

<span class="absolute right-3 top-2.5
text-slate-300">⌕</span>

</div>

</div>


<!-- LIST -->
<div id="detail-list"
class="flex-1 overflow-y-auto p-3">

<div class="text-center py-20 text-slate-400">
<p class="text-xs">
Pilih level pada grafik
</p>
</div>

</div>

</div>
</aside>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

let chartLevel,chartTren,pegawai=[],detailData=[];
const warna=['#06B6D4','#2563EB','#10B981','#F59E0B','#8B5CF6','#EF4444'];
const $=id=>document.getElementById(id);


/* STAT */

async function loadStats(){

try{

const r=await fetch('/hcr-skor-gabungan-json');
const {data}=await r.json(),n=data.length;

const avg=n
?(data.reduce((a,b)=>a+Number(b.skorGabungan),0)/n).toFixed(1)
:0;

const unggul=data.filter(x=>x.kategori==='Tinggi').length;
const v=document.querySelectorAll('.stat-value');

v[0].textContent=n;
v[1].textContent='8 / 8';
v[2].textContent=avg+'%';
v[3].textContent=unggul;

}catch(e){console.error(e)}

}


/* LEVEL */

async function loadLevel(){

const bulan=$('filter-bulan').value;
const tahun=$('filter-tahun').value;

try{

const r=await fetch(
`/hcr-skor-gabungan-json?bulan=${bulan}&tahun=${tahun}`
);

const {data}=await r.json();
pegawai=data;

const count={};

data.forEach(x=>{
const l=x.level||'Tanpa Level';
count[l]=(count[l]||0)+1;
});

const labels=Object.keys(count);
const values=labels.map(x=>count[x]);

$('totalChart').textContent=data.length;

if(chartLevel)chartLevel.destroy();


/* DONUT */

chartLevel=new Chart($('chartLevel'),{

type:'doughnut',

data:{
labels,
datasets:[{
data:values,
backgroundColor:labels.map((_,i)=>warna[i%warna.length]),
borderColor:'#fff',
borderWidth:4,
hoverOffset:8
}]
},

options:{
responsive:true,
maintainAspectRatio:false,
cutout:'72%',

plugins:{
legend:{
position:'bottom',
labels:{
usePointStyle:true,
padding:15,
font:{size:11}
}
},

tooltip:{
callbacks:{
label:c=>{
const t=c.dataset.data.reduce((a,b)=>a+b,0);
return ` ${c.label}: ${c.raw} pegawai (${(c.raw/t*100).toFixed(1)}%)`;
}
}
}
},

onClick:(e,items)=>{
if(items.length)
showDetail(labels[items[0].index]);
}

}

});


/* SUMMARY */

$('ringkasan-level').innerHTML=labels.map((l,i)=>{

const persen=data.length
?(count[l]/data.length*100).toFixed(0):0;

return`

<button onclick="showDetail('${l.replace(/'/g,"\\'") }')"
class="w-full text-left p-3 rounded-xl
hover:bg-slate-50 transition">

<div class="flex justify-between mb-2">

<span class="text-xs font-semibold">
${l}
</span>

<span class="text-[10px] text-slate-400">
${count[l]}
</span>

</div>

<div class="progress">

<div class="bar"
style="width:${persen}%;
background:${warna[i%warna.length]}">
</div>

</div>

<div class="flex justify-between mt-1">

<span class="text-[10px] text-slate-400">
${persen}% dari total
</span>

<span class="text-[10px] text-cyan-500">
Lihat →
</span>

</div>

</button>

`;

}).join('');

}catch(e){

console.error(e);

$('ringkasan-level').innerHTML=
'<p class="text-xs text-red-400">Gagal memuat data.</p>';

}

}


/* DRAWER */

function showDetail(level){

detailData=pegawai.filter(
x=>(x.level||'Tanpa Level')===level
);

const avg=detailData.length
?(detailData.reduce((a,b)=>a+Number(b.skorGabungan),0)/detailData.length).toFixed(1)
:0;

$('detail-title').textContent=level;
$('detail-total').textContent=detailData.length;
$('detail-score').textContent=avg+'%';
$('searchPegawai').value='';

renderDetail();

$('drawer-bg').classList.remove('hidden');
$('drawer').classList.remove('translate-x-full');

}


function renderDetail(){

const keyword=$('searchPegawai').value.toLowerCase();

const list=detailData.filter(p=>
(p.nama||'').toLowerCase().includes(keyword)
);

const bulan=$('filter-bulan').value;
const tahun=$('filter-tahun').value;

$('detail-list').innerHTML=list.length?list.map(p=>`

<a href="/hcr-detail-pegawai?pegawai=${p.id}&bulan=${bulan}&tahun=${tahun}"
class="flex items-center gap-3 p-3 rounded-xl
hover:bg-slate-50 transition">

<div class="w-9 h-9 shrink-0 rounded-full
bg-cyan-50 text-cyan-600 flex items-center
justify-center text-xs font-bold">
${(p.nama||'?').charAt(0).toUpperCase()}
</div>

<div class="flex-1 min-w-0">

<p class="text-sm font-semibold truncate">
${p.nama}
</p>

<p class="text-[10px] text-slate-400">
${p.nip||'-'}
</p>

</div>

<span class="px-2 py-1 rounded-lg text-[10px] font-bold
${
p.kategori==='Tinggi'
?'bg-green-50 text-green-600'
:p.kategori==='Sedang'
?'bg-yellow-50 text-yellow-600'
:'bg-red-50 text-red-600'
}">
${p.skorGabungan}%
</span>

</a>

`).join(''):
`
<div class="text-center py-16">
<p class="text-sm text-slate-400">
Pegawai tidak ditemukan
</p>
</div>
`;

}


/* SEARCH */

$('searchPegawai').addEventListener(
'input',renderDetail
);


/* CLOSE */

function closeDrawer(){

$('drawer').classList.add('translate-x-full');

setTimeout(
()=>$('drawer-bg').classList.add('hidden'),
250
);

}

$('close-detail').onclick=closeDrawer;
$('drawer-bg').onclick=closeDrawer;


/* TREND */

async function loadTrend(tahun){

try{

const r=await fetch(
`/hcr-tren-tahunan-json?tahun=${tahun}`
);

const {dataTren}=await r.json();

if(chartTren)chartTren.destroy();

chartTren=new Chart($('chartTren'),{

type:'line',

data:{
labels:[
'Jan','Feb','Mar','Apr','Mei','Jun',
'Jul','Agu','Sep','Okt','Nov','Des'
],

datasets:[{

data:dataTren,

borderColor:'#06B6D4',
backgroundColor:'rgba(6,182,212,.10)',

fill:true,
tension:.4,
borderWidth:2.5,
pointRadius:3,
pointHoverRadius:6

}]
},

options:{
responsive:true,
maintainAspectRatio:false,

plugins:{
legend:{display:false}
},

scales:{
x:{grid:{display:false}},

y:{
beginAtZero:true,
max:100,
ticks:{
callback:v=>v+'%'
}
}

}

}

});

}catch(e){
console.error(e)
}

}


/* FILTER */

$('filter-bulan').onchange=loadLevel;
$('filter-tahun').onchange=loadLevel;


document.querySelectorAll('.tahun-btn').forEach(btn=>{

btn.onclick=()=>{

document.querySelectorAll('.tahun-btn').forEach(x=>{

x.classList.remove(
'bg-white','shadow','text-slate-800'
);

x.classList.add('text-slate-400');

});

btn.classList.add(
'bg-white','shadow','text-slate-800'
);

btn.classList.remove('text-slate-400');

loadTrend(btn.dataset.tahun);

};

});


/* START */

$('filter-bulan').value=new Date().getMonth()+1;

loadStats();
loadLevel();
loadTrend(new Date().getFullYear());

</script>

</body>   
</html>
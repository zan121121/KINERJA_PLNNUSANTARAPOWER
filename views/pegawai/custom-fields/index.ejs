<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Kelola Field Tambahan - e-Kinerja HC</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar', { pageTitle: 'Kelola Field Tambahan' }) %>

  <main class="ml-64 pt-16 p-6">
    <div class="flex justify-between items-center mb-6">
      <div>
        <p class="text-sm text-gray-500">Data Pegawai / <span class="text-gray-700 font-medium">Kelola Field</span></p>
      </div>
      <a href="/pegawai/custom-fields/tambah" class="bg-brand-blue text-white px-4 py-2.5 rounded-lg font-semibold text-sm shadow-sm hover:opacity-90">
        + Tambah Field
      </a>
    </div>

    <% if (successMsg && successMsg.length > 0) { %>
      <div class="bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3 rounded-lg mb-4"><%= successMsg %></div>
    <% } %>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-left text-gray-500 text-xs uppercase tracking-wider">
          <tr>
            <th class="px-5 py-3 font-semibold">Nama Field</th>
            <th class="px-5 py-3 font-semibold">Tipe</th>
            <th class="px-5 py-3 font-semibold">Pilihan (Dropdown)</th>
            <th class="px-5 py-3 font-semibold text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% fields.forEach(f => { %>
            <tr class="hover:bg-gray-50 transition">
              <td class="px-5 py-3.5 font-medium text-gray-800"><%= f.field_label %></td>
              <td class="px-5 py-3.5">
                <span class="px-2.5 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-semibold capitalize"><%= f.field_type %></span>
              </td>
              <td class="px-5 py-3.5 text-gray-500">
                <% if (f.options) { %>
                  <div class="flex flex-wrap gap-1">
                    <% f.options.split(',').forEach(opt => { %>
                      <span class="px-2 py-0.5 bg-gray-100 rounded text-xs text-gray-600"><%= opt.trim() %></span>
                    <% }) %>
                  </div>
                <% } else { %>
                  <span class="text-gray-300">-</span>
                <% } %>
              </td>
              <td class="px-5 py-3.5 text-right space-x-3">
                <a href="/pegawai/custom-fields/edit/<%= f.id %>" class="text-blue-600 hover:underline text-sm font-medium">Edit</a>
                <a href="/pegawai/custom-fields/hapus/<%= f.id %>" class="text-red-600 hover:underline text-sm font-medium">Hapus</a>
              </td>
            </tr>
          <% }) %>
          <% if (fields.length === 0) { %>
            <tr><td colspan="4" class="px-5 py-10 text-center text-gray-400">Belum ada field tambahan</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</body>
</html>
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Tambah Field - e-Kinerja HC</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-50">
  <%- include('../../partials/sidebar') %>
  <%- include('../../partials/topbar', { pageTitle: 'Tambah Field Tambahan' }) %>

  <main class="ml-64 pt-16 p-6">
    <a href="/pegawai/custom-fields" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-brand-blue mb-4">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      Kembali
    </a>

    <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6 max-w-md">
      <p class="text-base font-bold text-gray-800 mb-1">Tambah Field Baru</p>
      <p class="text-sm text-gray-400 mb-5">Field ini akan otomatis muncul di form Tambah/Edit Pegawai</p>

      <% if (errorMsg && errorMsg.length > 0) { %>
        <div class="bg-red-50 border border-red-200 text-red-700 text-sm px-4 py-3 rounded-lg mb-4"><%= errorMsg %></div>
      <% } %>

      <form action="/pegawai/custom-fields/tambah" method="POST" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Nama Field</label>
          <input type="text" name="field_label" required placeholder="Contoh: Status Pegawai"
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-600 mb-1.5">Tipe Field</label>
          <select name="field_type" id="field_type" required
            class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-blue">
            <option value="text">Teks Bebas</option>
            <option value="number">Angka</option>
            <option value="date">Tanggal</option>
            <option value="dropdown">Dropdown (Pilihan)</option>
          </select>
        </div>

        <div id="options-wrapper" class="hidden border border-gray-100 rounded-lg p-4 bg-gray-50">
          <label class="block text-sm font-semibold text-gray-700 mb-2.5">Pilihan Dropdown</label>
          <div id="options-list" class="space-y-2">
            <div class="flex gap-2 option-row">
              <input type="text" name="option_items[]" placeholder="Contoh: Organik"
                class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-blue">
              <button type="button" class="hapus-opsi bg-red-50 text-red-600 w-9 h-9 rounded-lg font-bold shrink-0 hover:bg-red-100">×</button>
            </div>
          </div>
          <button type="button" id="tambah-opsi" class="mt-3 text-sm text-brand-blue font-semibold flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            Tambah Pilihan
          </button>
        </div>

        <div class="flex gap-3 pt-2">
          <a href="/pegawai/custom-fields" class="flex-1 text-center border border-gray-200 text-gray-600 py-2.5 rounded-lg font-semibold text-sm hover:bg-gray-50">Batal</a>
          <button type="submit" class="flex-1 bg-brand-blue text-white font-semibold py-2.5 rounded-lg text-sm shadow-sm hover:opacity-90">Simpan Field</button>
        </div>
      </form>
    </div>
  </main>

  <script>
    const tipeSelect = document.getElementById('field_type');
    const optionsWrapper = document.getElementById('options-wrapper');
    const optionsList = document.getElementById('options-list');
    const tambahOpsiBtn = document.getElementById('tambah-opsi');

    tipeSelect.addEventListener('change', () => {
      optionsWrapper.classList.toggle('hidden', tipeSelect.value !== 'dropdown');
    });

    tambahOpsiBtn.addEventListener('click', () => {
      const row = document.createElement('div');
      row.className = 'flex gap-2 option-row';
      row.innerHTML = `
        <input type="text" name="option_items[]" placeholder="Pilihan lain..."
          class="flex-1 border border-gray-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-brand-blue">
        <button type="button" class="hapus-opsi bg-red-50 text-red-600 w-9 h-9 rounded-lg font-bold shrink-0 hover:bg-red-100">×</button>
      `;
      optionsList.appendChild(row);
    });

    optionsList.addEventListener('click', (e) => {
      if (e.target.classList.contains('hapus-opsi')) {
        const rows = optionsList.querySelectorAll('.option-row');
        if (rows.length > 1) {
          e.target.closest('.option-row').remove();
        } else {
          e.target.closest('.option-row').querySelector('input').value = '';
        }
      }
    });
  </script>
</body>
</html>
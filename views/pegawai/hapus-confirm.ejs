<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Hapus Pegawai - e-Kinerja HC</title>
  <link rel="stylesheet" href="/css/output.css">
</head>
<body class="bg-gray-100">
  <nav class="bg-brand-blue px-6 py-4 flex justify-between items-center">
    <span class="text-white font-bold">e-Kinerja HC</span>
    <a href="/pegawai" class="text-white underline text-sm">← Kembali</a>
  </nav>

  <div class="p-8 flex justify-center">
    <div class="bg-white shadow-lg rounded-xl p-8 w-full max-w-md">
      <h1 class="text-xl font-bold text-gray-800 mb-3">Hapus "<%= pegawai.nama %>"?</h1>

      <% if (jumlahHcr > 0) { %>
        <div class="bg-yellow-100 text-yellow-800 text-sm px-3 py-3 rounded mb-4">
          ⚠ Pegawai ini punya <strong><%= jumlahHcr %></strong> data HCR yang sudah tersimpan.
          Kalau dihapus, semua data itu akan <strong>ikut terhapus permanen</strong> dan tidak bisa dikembalikan.
        </div>
      <% } else { %>
        <div class="bg-green-100 text-green-700 text-sm px-3 py-3 rounded mb-4">
          Belum ada data HCR untuk pegawai ini — aman untuk dihapus.
        </div>
      <% } %>

      <div class="flex gap-3">
        <a href="/pegawai" class="flex-1 text-center border border-gray-300 text-gray-700 py-2 rounded-lg font-semibold">
          Batal
        </a>
        <form action="/pegawai/hapus/<%= pegawai.id %>" method="POST" class="flex-1">
          <button type="submit" class="w-full bg-red-600 text-white py-2 rounded-lg font-semibold">
            Ya, Hapus
          </button>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
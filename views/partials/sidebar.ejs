<!-- Watermark logo di background -->
<div class="fixed inset-0 flex items-center justify-center pointer-events-none z-0" style="left: 256px;">
  <img src="/img/logo/pln.png" alt="" class="w-96 h-96 object-contain" style="opacity: 0.04;">
</div>

<!-- Loading Overlay -->
<div id="loading-overlay" class="hidden fixed inset-0 bg-brand-navy z-[100] flex flex-col items-center justify-center">
  <div class="relative w-20 h-20 mb-6">
    <img src="/img/logo/pln.png" alt="Loading" class="w-full h-full object-contain animate-pulse">
    <svg class="absolute inset-0 w-full h-full animate-spin" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="46" fill="none" stroke="#00CCFF" stroke-width="4" stroke-dasharray="70 200" stroke-linecap="round" />
    </svg>
  </div>
  <p class="text-white font-bold text-base tracking-wide">PLN Nusantara Power</p>
  <p class="text-white/50 text-xs mt-1">UP Belawan · e-Kinerja HC</p>
  <p class="text-brand-blue text-xs mt-4 animate-pulse">Memuat halaman, mohon tunggu sebentar...</p>
</div>

<aside class="fixed top-0 left-0 h-screen w-64 bg-brand-navy text-white flex flex-col z-40">
  <!-- Logo -->
  <div class="px-5 py-6 border-b border-white/10">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-lg bg-white flex items-center justify-center overflow-hidden shrink-0 p-1.5">
        <img src="/img/logo/pln.png" alt="Logo PLN" class="w-full h-full object-contain">
      </div>
      <div>
        <p class="font-bold text-sm leading-tight">
          PLN <span class="text-brand-yellow">Nusantara</span>
        </p>
        <p class="text-[11px] text-white/60 leading-tight">Power UP Belawan</p>
      </div>
    </div>
  </div>

  <!-- Menu -->
  <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
    <% const isActive = (path) => currentPath && currentPath.startsWith(path); %>

    <a href="/dashboard" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition <%= isActive('/dashboard') ? 'bg-brand-blue text-brand-navy font-bold' : 'text-white/70 hover:bg-white/10 hover:text-white' %>">
      <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Dashboard
    </a>
    <a href="/pegawai" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition <%= isActive('/pegawai') ? 'bg-brand-blue text-brand-navy font-bold' : 'text-white/70 hover:bg-white/10 hover:text-white' %>">
      <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 100-8 4 4 0 000 8zm6 1a4 4 0 10-8 0" />
      </svg>
      Data Pegawai
    </a>
    <a href="/hcr-menu" class="nav-link flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition <%= isActive('/hcr') ? 'bg-brand-blue text-brand-navy font-bold' : 'text-white/70 hover:bg-white/10 hover:text-white' %>">
      <svg class="w-[18px] h-[18px]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
      </svg>
      Input HCR
    </a>
  </nav>

  <!-- Footer sidebar -->
  <div class="px-4 py-4 border-t border-white/10">
    <div class="bg-white/5 rounded-lg px-3 py-2.5">
      <p class="text-xs font-semibold">UPBW Belawan</p>
      <p class="text-[10px] text-white/40 mt-0.5" id="jam-realtime"></p>
    </div>
  </div>
</aside>

<script>
  function updateJam() {
    const el = document.getElementById('jam-realtime');
    if (!el) return;
    const now = new Date();
    const opsi = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
    const tanggal = now.toLocaleDateString('id-ID', opsi);
    const jam = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
    el.textContent = `${tanggal} · ${jam} WIB`;
  }
  updateJam();
  setInterval(updateJam, 60000);

  // Loading overlay dengan minimal delay biar kelihatan jelas transisinya
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', function(e) {
      const tujuan = this.getAttribute('href');
      if (tujuan === window.location.pathname) return;

      e.preventDefault();
      document.getElementById('loading-overlay').classList.remove('hidden');

      setTimeout(() => {
        window.location.href = tujuan;
      }, 550);
    });
  });
</script>